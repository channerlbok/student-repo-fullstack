doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title + ' | World Atlas'
    link(rel='stylesheet' href='/style.css')
  body
    header
      a.brand(href='/home') World Atlas
      nav(aria-label='Main navigation')
        a(href='/home') Home
        a(href='/countries') Countries
        a(href='/populous') Populous
        a(href='/regions') Regions
    main
      h1= title
      block content
    footer Country data provided by REST Countries. Missing fields are marked explicitly.
